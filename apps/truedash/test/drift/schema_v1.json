  "fixed_sql": [
    {
      "name": "server_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"server_profiles\" (\"id\" TEXT NOT NULL CHECK (length(id) BETWEEN 1 AND 128), \"display_name\" TEXT NOT NULL CHECK (length(display_name) BETWEEN 1 AND 256), \"original_host_input\" TEXT NOT NULL CHECK (length(original_host_input) BETWEEN 1 AND 2048), \"normalized_endpoint\" TEXT NOT NULL UNIQUE CHECK (length(normalized_endpoint) BETWEEN 1 AND 2048), \"last_known_version\" TEXT NOT NULL CHECK (length(last_known_version) BETWEEN 1 AND 128), \"created_at_ms\" INTEGER NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL UNIQUE CHECK (sort_order >= 0), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_selection",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_selection\" (\"singleton_id\" INTEGER NOT NULL CHECK (singleton_id = 1), \"selected_profile_id\" TEXT NULL REFERENCES server_profiles (id) ON DELETE SET NULL, PRIMARY KEY (\"singleton_id\"));"
        }
      ]
    },
    {
      "name": "profile_capabilities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profile_capabilities\" (\"profile_id\" TEXT NOT NULL REFERENCES server_profiles (id) ON DELETE CASCADE, \"method_name\" TEXT NOT NULL CHECK (length(method_name) BETWEEN 1 AND 255 AND method_name NOT GLOB '*[^A-Za-z0-9_.]*' AND method_name NOT GLOB '.*' AND method_name NOT GLOB '*.' AND method_name NOT GLOB '*..*'), \"observed_at_ms\" INTEGER NOT NULL, \"expires_at_ms\" INTEGER NOT NULL CHECK (expires_at_ms > observed_at_ms), PRIMARY KEY (\"profile_id\", \"method_name\"));"
        }
      ]
    }
