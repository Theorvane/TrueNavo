#!/usr/bin/env python3
"""Minimal unzip compatibility for Flutter SDK bootstrap."""

from __future__ import annotations

import os
from pathlib import Path
import stat
import sys
import zipfile


def main(argv: list[str]) -> int:
    try:
        destination_index = argv.index("-d")
        destination = Path(argv[destination_index + 1]).resolve()
        archive = next(
            Path(value)
            for index, value in enumerate(argv)
            if not value.startswith("-")
            and index not in (destination_index, destination_index + 1)
        )
    except (StopIteration, ValueError, IndexError):
        print("usage: unzip [-o] [-q] ARCHIVE -d DESTINATION", file=sys.stderr)
        return 2

    destination.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(archive) as bundle:
        for member in bundle.infolist():
            target = (destination / member.filename).resolve()
            if os.path.commonpath((destination, target)) != str(destination):
                raise ValueError(f"unsafe archive path: {member.filename}")
            bundle.extract(member, destination)
            mode = member.external_attr >> 16
            if mode and not stat.S_ISLNK(mode):
                target.chmod(stat.S_IMODE(mode))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
